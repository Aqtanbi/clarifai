# Скопируйте в .env и укажите ключ. Файл .env в git не попадает.

# Провайдер: gemini (по умолчанию) | openai (любой OpenAI-совместимый: OpenAI, OpenRouter, Groq, Ollama)
LLM_PROVIDER=gemini

# Google AI Studio: https://aistudio.google.com/apikey  (бесплатный тариф достаточен)
GEMINI_API_KEY=your_gemini_api_key_here
# Актуальный список моделей: python main.py --list-models
GEMINI_MODEL=gemini-3.5-flash-lite
# Запасные модели, если основная перегружена (ошибка 503), через запятую
GEMINI_FALLBACK_MODELS=gemini-3.5-flash

# OpenAI-совместимый провайдер (если LLM_PROVIDER=openai)
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=            # Ollama: http://localhost:11434/v1  ·  OpenRouter: https://openrouter.ai/api/v1

# Необязательные настройки
# BATCH_SIZE=8                # требований в одном запросе проверки
# LLM_PARALLEL=4               # одновременных запросов к модели (при лимитах 429 уменьшите до 1–2)
# LLM_TIMEOUT=240              # таймаут одного запроса к модели, с
# SIM_TIMEOUT=20              # таймаут исполняемой модели, с
# LLM_CACHE=1                 # кэш ответов в .cache/ (повторный прогон без запросов к API)

# Только для сайта (Vercel)
# ACCESS_CODE=                # если задан — запуск с серверным ключом только по коду
# MCP_TOKEN=                  # если задан — /mcp требует заголовок Authorization: Bearer <MCP_TOKEN>
